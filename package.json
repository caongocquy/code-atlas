{
  "name": "@showdar2112/code-atlas",
  "version": "1.6.0",
  "description": "A local-first code-intelligence engine with optional AI.",
  "bin": {
    "code-atlas": "dist/cli.js"
  },
  "files": [
    "dist",
    "vendor/parsers"
  ],
  "scripts": {
    "dev": "tsx watch src/adapters/http/http-server.ts",
    "dev:ui": "vite --config web/vite.config.ts",
    "build": "tsc && vite build --config web/vite.config.ts",
    "lint": "eslint .",
    "ui:build": "vite build --config web/vite.config.ts",
    "ui:typecheck": "tsc -p web/tsconfig.json --noEmit",
    "test": "node --import tsx/esm --test test/*.test.ts",
    "test:mcp:inspector": "node --import tsx/esm --test test/phase15e-mcp-inspector.test.ts",
    "eval:context": "node --import tsx/esm --input-type=module -e \"import { runContextEval } from './eval/context/run.ts'; const result = await runContextEval({ cwd: process.cwd(), reportPath: 'artifacts/context-eval-report.json' }); process.exit(result.exitCode);\"",
    "eval:context:update-baseline": "node --import tsx/esm --input-type=module -e \"import { updateContextBaseline } from './eval/context/update-baseline.ts'; const result = await updateContextBaseline({ cwd: process.cwd(), write: process.argv.includes('--write') }); process.stdout.write(result.diff);\" --",
    "eval:retrieval": "node --import tsx/esm eval/retrieval/cli.ts",
    "eval:retrieval:promote-baseline": "node --import tsx/esm eval/retrieval/cli.ts promote --confirm-reviewed",
    "parsers:prepare": "node scripts/parser-distribution.mjs prepare",
    "parsers:build": "node scripts/parser-distribution.mjs prepare --build-missing",
    "parsers:verify": "node scripts/parser-distribution.mjs verify --all-targets",
    "prepack": "npm run parsers:verify"
  },
  "keywords": [
    "code intelligence",
    "code search",
    "code graph",
    "repository analysis",
    "mcp"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caongocquy/code-atlas.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/caongocquy/code-atlas#readme",
  "bugs": {
    "url": "https://github.com/caongocquy/code-atlas/issues"
  },
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "dependencies": {
    "@bufbuild/protobuf": "2.11.0",
    "@clack/prompts": "1.8.1",
    "@fastify/static": "^10.1.3",
    "@huggingface/transformers": "4.3.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@scip-code/scip": "0.10.0",
    "chalk": "^6.0.0",
    "fastify": "^5.12.1",
    "figures": "^6.1.0",
    "graphology": "^0.26.0",
    "highlight.js": "^11.12.0",
    "ignore": "5.3.2",
    "jsonc-parser": "3.3.1",
    "node-gyp-build": "4.8.4",
    "picocolors": "1.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sigma": "^3.0.3",
    "smol-toml": "1.8.0",
    "uuid": "^14.0.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/eslint-parser": "^8.0.1",
    "@babel/plugin-syntax-jsx": "^8.0.1",
    "@babel/plugin-syntax-typescript": "^8.0.3",
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/inspector": "2.7.0",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.9.1",
    "node-addon-api": "7.1.1",
    "node-gyp": "12.3.0",
    "tree-sitter": "0.25.1",
    "tree-sitter-cli": "0.23.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
